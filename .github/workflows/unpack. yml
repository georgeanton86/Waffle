name: Unpack Waffle
on:
  push:
    paths:
      - ".github/workflows/unpack.yml"
  workflow_dispatch:
permissions:
  contents: write
jobs:
  unpack:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Restore the real folders
        run: |
          set -euo pipefail
          test -f waffle.zip
          find . -mindepth 1 -maxdepth 1 ! -name .git ! -name waffle.zip -exec rm -rf {} +
          unzip -o waffle.zip
          rm -f waffle.zip
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add -A
          git commit -m "Put Waffle back in its folders"
          git push
